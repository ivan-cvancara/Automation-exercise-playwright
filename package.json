{
  "name": "playwright-trainig",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright training — shared WebCore-style helpers, site app objects, JSON test data",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:ae": "playwright test tests/automation-exercise",
    "test:cucumber": "cucumber-js",
    "steps": "node scripts/list-steps.js",
    "inspect": "ts-node -r tsconfig-paths/register scripts/inspect-page.ts",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "e2e",
    "testing"
  ],
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^12.8.3",
    "@cucumber/pretty-formatter": "^3.3.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.15.17",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
