{
  "name": "playwright-training",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright training - E2E tests for the Automation Exercise demo shop (Playwright Test + Cucumber)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "npm run typecheck && npm run lint && npm run steps -- --check && playwright test --project=chromium && cucumber-js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:ae": "playwright test tests/automation-exercise",
    "test:cucumber": "cucumber-js",
    "steps": "node scripts/list-steps.js",
    "inspect": "ts-node -r tsconfig-paths/register scripts/inspect-page.ts",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "e2e",
    "testing"
  ],
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^12.8.3",
    "@cucumber/pretty-formatter": "^3.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.15.17",
    "eslint": "^10.12.0",
    "eslint-plugin-playwright": "^2.12.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0"
  }
}
